<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sonverter</RootNamespace>
    <AssemblyName>Sonverter</AssemblyName>
    <!-- 嵌入构建日期（如 202609181），不再使用传统语义化版本号 -->
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd1'))</BuildDate>
    <InformationalVersion>$(BuildDate)</InformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT：固定时区/文化，减小体积并避免依赖 ICU -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbolsDuringPublish>true</StripSymbolsDuringPublish>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
    <EmbeddedResource Include="template.json" />
    <!-- 前端资源编译进二进制（单文件部署，不依赖外部 wwwroot 目录） -->
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="template.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
