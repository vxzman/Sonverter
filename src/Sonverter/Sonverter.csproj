<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sonverter</RootNamespace>
    <AssemblyName>Sonverter</AssemblyName>
    <!-- 版本遵循 SemVer：MAJOR.MINOR.PATCH。当前为首个稳定版本。 -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <BuildTimestamp>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTimestamp>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT：固定时区/文化，减小体积并避免依赖 ICU -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbolsDuringPublish>true</StripSymbolsDuringPublish>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
    <EmbeddedResource Include="template.json" />
    <!-- 前端资源编译进二进制（单文件部署，不依赖外部 wwwroot 目录） -->
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="template.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
